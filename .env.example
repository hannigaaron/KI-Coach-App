# Port des API Servers
PORT=8787

# Pfad zur SQLite Datei
DATABASE_PATH=./data/coach.sqlite

# Anthropic API Key. Ohne Key laeuft die App im Offline Modus mit regelbasiertem Fallback.
ANTHROPIC_API_KEY=

# Modell fuer den Coach
COACH_MODEL=claude-sonnet-5

# Gemeinsames Secret fuer die Signatur von Client Tokens
AUTH_SECRET=change-me-in-production
